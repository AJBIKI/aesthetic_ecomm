{
  "name": "the-monsoon-club-backend",
  "version": "1.0.0",
  "description": "The Monsoon Club — high-fashion e-commerce backend",
  "private": true,
  "scripts": {
    "build": "npx @nestjs/cli build",
    "start": "node dist/src/main",
    "start:dev": "npx @nestjs/cli start --watch",
    "start:prod": "node dist/src/main",
    "prisma:generate": "npx -p prisma@6 prisma generate",
    "prisma:push": "npx -p prisma@6 prisma db push",
    "prisma:migrate": "npx -p prisma@6 prisma migrate dev",
    "prisma:seed": "npx -p ts-node ts-node --transpile-only -r tsconfig-paths/register prisma/seed.ts",
    "prisma:studio": "npx -p prisma@6 prisma studio",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest"
  },
  "prisma": {
    "seed": "npx -p ts-node ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.5.0",
    "multer": "^2.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "razorpay": "^2.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
